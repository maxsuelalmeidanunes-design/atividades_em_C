#include <stdio.h>
#include <math.h>
 
int main() {
    float area, litros;
    int latas;
    float total;
 
    printf("Digite a area que sera pintada em metros quadrados: ");
    scanf("%f", &area);
 
    litros = area / 3;
    latas = (int)ceil(litros / 18);
    total = latas * 80;
 
    printf("Quantidade de latas: %d\n", latas);
    printf("Valor total: R$ %.2f\n", total);
 
    return 0;
}



